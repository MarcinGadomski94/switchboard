{
  "name": "switchboard",
  "version": "2.4.2",
  "license": "MIT",
  "description": "Local web app to run, supervise and switch many Claude Code, Codex CLI and OpenCode sessions at once.",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "ai-agents",
    "coding-agents",
    "agent-orchestration",
    "codex-cli",
    "opencode",
    "mcp",
    "git-worktree",
    "tailscale",
    "developer-tools"
  ],
  "homepage": "https://github.com/MarcinGadomski94/switchboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcinGadomski94/switchboard.git"
  },
  "bugs": {
    "url": "https://github.com/MarcinGadomski94/switchboard/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node tools/dev.ts",
    "build": "vite build && node tools/release/helper-bundle.ts",
    "start": "node src/server/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.npx.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "perf:guard": "node tools/release/helper-bundle.ts && node tools/bench/soak.ts --sessions 6 --active-min 1 --idle-min 3 --profile-min 0 --sample-s 15 --out .bench/perf-guard --max-idle-cpu 4 --max-idle-heap-growth-mb 5 --max-helper-mb 85",
    "icons": "node tools/icons/render.ts",
    "screenshots": "node tools/screenshots/readme.ts",
    "demo-video": "node tools/screenshots/demo-video.ts",
    "service:install": "node tools/service/install.ts",
    "service:uninstall": "node tools/service/uninstall.ts",
    "frame-helper:safari": "node tools/frame-helper/build-safari.ts",
    "release:package": "node tools/release/package.ts",
    "version": "node tools/release/server-json.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fastify": "5.12.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/standalone": "7.29.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "gifenc": "1.0.3",
    "mermaid": "12.2.0",
    "prototype-react": "npm:react@18.3.1",
    "prototype-react-dom": "npm:react-dom@18.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "prototype-react-dom": {
      "react": "$react"
    }
  }
}

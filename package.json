{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "Local web app for running and supervising many Claude Code sessions.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node tools/dev.ts",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/standalone": "7.29.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prototype-react": "npm:react@18.3.1",
    "prototype-react-dom": "npm:react-dom@18.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "prototype-react-dom": {
      "react": "$react"
    }
  }
}

{
  "manifest_version": 3,
  "name": "Switchboard frame helper",
  "version": "2.0.0",
  "description": "Lets Switchboard (on 127.0.0.1 / localhost) show your saved signed-in sites, such as Jira, in its tool frame, in Switchboard's own tab only.",
  "minimum_chrome_version": "101",
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["marker.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*/*"],
      "js": ["storage-access.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
